# Copy to .env (`make env` fills the Supabase values from the local stack). Never commit .env.

# --- Supabase (local: `npx supabase status -o env`)
SUPABASE_URL=http://127.0.0.1:55421
PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
DEMO_PASSWORD=change-me-demo-password

# Signs short-lived training job tokens (defaults to a hash of the service role key)
TRAIN_JOB_SECRET=

# --- NATS
NATS_URL=nats://127.0.0.1:4222
NATS_CREDS=

# --- Vultr (training runs locally unless TRAIN_RUNNER=vultr and VULTR_API_KEY are both set)
VULTR_API_KEY=
TRAIN_RUNNER=local
# Where the Training VM reaches the API (public URL of the App VM, or its VPC address)
ZENTRY_PUBLIC_API_URL=
ZENTRY_GIT_REF=main
VULTR_TRAIN_SNAPSHOT_ID=
VULTR_REGION=sgp
VULTR_TRAIN_PLAN=vc2-2c-4gb
VULTR_VPC_ID=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
LLM_MODEL=
VULTR_VECTOR_COLLECTION_ID=

# --- Object Storage (S3-compatible)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=zentry
