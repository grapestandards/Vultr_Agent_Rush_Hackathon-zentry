# Copy to .env (`make env` fills the Supabase values from the local stack). Never commit .env.

# --- Supabase (local: `npx supabase status -o env`)
SUPABASE_URL=http://127.0.0.1:55421
PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
DEMO_PASSWORD=change-me-demo-password

# --- NATS
NATS_URL=nats://127.0.0.1:4222
NATS_CREDS=

# --- Vultr (leave VULTR_API_KEY empty to train locally in a container)
VULTR_API_KEY=
VULTR_TRAIN_SNAPSHOT_ID=
VULTR_REGION=sgp
VULTR_TRAIN_PLAN=
VULTR_VPC_ID=
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
LLM_MODEL=
VULTR_VECTOR_COLLECTION_ID=

# --- Object Storage (S3-compatible)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=zentry
